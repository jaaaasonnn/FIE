# FieGH environment variables. Names only: copy to .env and fill in the values.
# Never commit .env.

# App
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# Database (Supabase Postgres)
DATABASE_URL=
DIRECT_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Exchange rate
INITIAL_USD_TO_GHS=
EXCHANGE_RATE_API_KEY=

# Maps
NEXT_PUBLIC_MAPTILER_KEY=

# Africa's Talking: NOT USED BY ANY CODE. These two were added before a
# provider was chosen and nothing reads them. Messaging is set up further
# down, under "Messaging".
AT_API_KEY=
AT_USERNAME=

# Images (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Error monitoring (Sentry)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Cron jobs: Vercel sends this as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# ── Payout, completion and refund switches ───────────────────────────────
# All of them are OFF when unset. Leave them unset until launch.
#
# PAYOUTS_ENABLED: must be exactly "true" before any transfer to a host is
# attempted. Anything else (unset, "1", "TRUE") keeps the payout job in dry
# run: it reports what it would do, writes nothing and calls nothing.
PAYOUTS_ENABLED=
#
# PAYOUTS_NOT_BEFORE: a date as YYYY-MM-DD (UTC). Only bookings created on or
# after this day can ever be paid out. Required: with PAYOUTS_ENABLED=true but
# no valid date here, the payout job still stays in dry run.
PAYOUTS_NOT_BEFORE=
#
# COMPLETION_ENABLED: must be exactly "true" before the completion job marks
# any booking COMPLETED. Otherwise it only reports which bookings it would.
COMPLETION_ENABLED=
#
# REFUNDS_ENABLED: must be exactly "true" before any refund is sent to
# Paystack. While it is off, cancelling still works and the refund is recorded
# as owed, but nothing is sent. Refunds recorded while off are sent by the
# hourly refund job once this is turned on.
REFUNDS_ENABLED=
#
# DISPUTE_DECISIONS_ENABLED: must be exactly "true" before an admin's decision
# on a dispute takes effect. While it is off, deciding only reports what it
# would do and writes nothing. Reporting a problem and holding the host's
# payout are always on. A refund a decision creates is still behind
# REFUNDS_ENABLED, and a payout behind PAYOUTS_ENABLED.
DISPUTE_DECISIONS_ENABLED=
#
# PAYMENT_WEBHOOK_ENABLED: must be exactly "true" before Paystack's
# charge.success webhook confirms a payment. While it is off the event is
# still signature-checked and logged as what it would do, and nothing is
# written. Payments are still confirmed when the guest's browser returns.
PAYMENT_WEBHOOK_ENABLED=
#
# BOOKING_EXPIRY_ENABLED: must be exactly "true" before the expiry job ends
# unpaid bookings and unanswered requests. Otherwise it only reports which
# ones it would end, and never calls Paystack.
BOOKING_EXPIRY_ENABLED=
#
# BOOKING_EXPIRY_NOT_BEFORE: a date as YYYY-MM-DD (UTC). Only bookings created
# on or after this day can ever be ended by the expiry job. Required: with
# BOOKING_EXPIRY_ENABLED=true but no valid date here, the job stays in dry run.
BOOKING_EXPIRY_NOT_BEFORE=
#
# RENT_REMINDERS_ENABLED: must be exactly "true" before the daily rent
# reminder job writes any reminder for a monthly or long-term stay. Otherwise
# it only reports which reminders it would write, and never calls Paystack.
# A reminder is itself only logged until messaging (below) is switched on.
RENT_REMINDERS_ENABLED=
#
# RENT_DEPOSIT_COVER_ENABLED: must be exactly "true" before an admin can
# cover a missed rent payment from the damage deposit. While it is off, the
# button only reports what it would do and writes nothing.
RENT_DEPOSIT_COVER_ENABLED=
#
# PAYOUT_LIMIT_GHS: not a switch. The most a single transfer to a host may
# be, in cedis (for example 50000). A payout above it is not sent: it is
# marked HELD, an alert is raised once, and a person pays it. It is never
# split into smaller transfers and never retried. Unset (or not a positive
# number): no payout is held for its size, and one too large for Paystack is
# refused by Paystack and recorded as failed. Take the figure from your
# Paystack dashboard: it can differ for mobile money and bank accounts, so
# use the lower one.
PAYOUT_LIMIT_GHS=
#
# Every cron job also accepts ?dryRun=1 to force a report-only run.

# ── Messaging (email and SMS) ────────────────────────────────────────────
# Everything here is OFF when unset. Leave it all unset until a provider
# account exists. While off, every message is still worked out and recorded
# in the message log (admin page, Messages tab) with status LOGGED, and
# nothing is sent anywhere. A message logged while off is never sent later.
#
# MESSAGING_ENABLED: must be exactly "true" before anything can be sent.
MESSAGING_ENABLED=
#
# EMAIL_PROVIDER / SMS_PROVIDER: the adapter each channel sends through.
# Unset (or "log") means that channel only logs, even with MESSAGING_ENABLED
# on, so email can go live before SMS. A name with no adapter sends nothing.
# Email: "resend" is the one real adapter (src/lib/messaging/providers). Real
# email goes out only with MESSAGING_ENABLED=true AND EMAIL_PROVIDER=resend.
# SMS: "arkesel" is the one real adapter. Real SMS goes out only with
# MESSAGING_ENABLED=true AND SMS_PROVIDER=arkesel. Read "Before turning SMS
# on" in CLAUDE.md first.
EMAIL_PROVIDER=
SMS_PROVIDER=
#
# RESEND_API_KEY: the Resend API key, used only by the resend adapter. It is
# read from the environment when an email is sent and is never logged or
# stored. If it is missing while email is switched on, nothing is called and
# each email is retried (5 minutes, 30 minutes, 2 hours), then given up with
# an alert. The fiegh.com domain must be verified in Resend first.
RESEND_API_KEY=
#
# EMAIL_FROM: the whole From line. Default: "FieGH <support@fiegh.com>".
# The address must be on a domain verified in Resend.
# SUPPORT_EMAIL: the reply-to, also shown in messages. Default:
# support@fiegh.com. SMS_SENDER_ID: default FieGH. It must be the sender ID
# Arkesel has approved: 1 to 11 letters, digits or spaces.
EMAIL_FROM=
SUPPORT_EMAIL=
SMS_SENDER_ID=
#
# ARKESEL_API_KEY: the Arkesel SMS API key (Arkesel dashboard, SMS API), used
# only by the arkesel adapter, the balance check and the test script. Read
# from the environment when an SMS is sent; never logged or stored. Missing
# while SMS is switched on: nothing is called and each SMS is retried, then
# given up with an alert.
ARKESEL_API_KEY=
#
# SMS_WEBHOOK_SECRET: at least 32 random characters (for example the output
# of `openssl rand -hex 32`). Each SMS then asks Arkesel for a delivery report
# on its own signed link, /api/webhooks/sms/arkesel/<id>/<signature>, and the
# admin Messages tab shows Delivered or Not delivered. Unset or shorter: no
# report is asked for and every report is refused. Changing it makes the
# links of SMS already sent useless (their reports are refused).
SMS_WEBHOOK_SECRET=
#
# SMS_LOW_BALANCE_ALERT: a whole number of SMS credits. The hourly
# sms-balance job reads the Arkesel balance (only while SMS is switched on
# through Arkesel) and raises one Sentry alert a day while it is below this.
# Unset: the balance is not checked. A run out of credit is alerted anyway,
# when an SMS is refused for it (SMS_LOW_BALANCE).
SMS_LOW_BALANCE_ALERT=
#
# To send one test email or SMS by hand before switching anything on (they
# ignore the switches and write nothing to the database):
#   npm run email:test -- you@example.com --confirm
#   npm run sms:test -- 0XXXXXXXXX --confirm --sandbox   (Arkesel's sandbox: not delivered, not charged)
#   npm run sms:test -- 0XXXXXXXXX --confirm             (one real, charged SMS)
#
# ADMIN_ALERT_EMAIL: one shared inbox for everything admins are emailed
# about. Unset: each admin account that has an email address is sent it
# instead. With neither, the email is skipped (the in-app notices still
# appear).
ADMIN_ALERT_EMAIL=
#
# The drill adapters (fail-drill-email, fail-drill-sms) are test-only. They
# cannot be selected in production (NODE_ENV=production or
# VERCEL_ENV=production): naming one there sends nothing and raises an alert.

# ── Contact details ──────────────────────────────────────────────────────
# SUPPORT_PHONE: the support phone number shown in the site footer, written
# as it should appear (for example +233 30 000 0000). Unset: no phone number
# is shown at all. A placeholder is never shown.
SUPPORT_PHONE=

# ── Accounts ─────────────────────────────────────────────────────────────
# EMAIL_VERIFICATION_REQUIRED: must be exactly "true" before someone whose
# email address is not confirmed is held back from booking, listing a home
# or paying. Browsing is never held back. OFF when unset. Turn it on only
# once email is really being sent (MESSAGING_ENABLED=true and
# EMAIL_PROVIDER=resend): until then nobody new could receive the link.
# Confirmation, email-change and password-reset links are stored encrypted
# with a key derived from NEXTAUTH_SECRET (above) until they are sent, so
# that must be set to 16 characters or more.
EMAIL_VERIFICATION_REQUIRED=
