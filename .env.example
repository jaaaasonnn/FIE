# FieGH environment variables. Names only: copy to .env and fill in the values.
# Never commit .env.

# App
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# Database (Supabase Postgres)
DATABASE_URL=
DIRECT_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Exchange rate
INITIAL_USD_TO_GHS=
EXCHANGE_RATE_API_KEY=

# Maps
NEXT_PUBLIC_MAPTILER_KEY=

# Africa's Talking: NOT USED BY ANY CODE. These two were added before a
# provider was chosen and nothing reads them. Messaging is set up further
# down, under "Messaging".
AT_API_KEY=
AT_USERNAME=

# Images (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Error monitoring (Sentry)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Cron jobs: Vercel sends this as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# ── Payout, completion and refund switches ───────────────────────────────
# All of them are OFF when unset. Leave them unset until launch.
#
# PAYOUTS_ENABLED: must be exactly "true" before any transfer to a host is
# attempted. Anything else (unset, "1", "TRUE") keeps the payout job in dry
# run: it reports what it would do, writes nothing and calls nothing.
PAYOUTS_ENABLED=
#
# PAYOUTS_NOT_BEFORE: a date as YYYY-MM-DD (UTC). Only bookings created on or
# after this day can ever be paid out. Required: with PAYOUTS_ENABLED=true but
# no valid date here, the payout job still stays in dry run.
PAYOUTS_NOT_BEFORE=
#
# COMPLETION_ENABLED: must be exactly "true" before the completion job marks
# any booking COMPLETED. Otherwise it only reports which bookings it would.
COMPLETION_ENABLED=
#
# REFUNDS_ENABLED: must be exactly "true" before any refund is sent to
# Paystack. While it is off, cancelling still works and the refund is recorded
# as owed, but nothing is sent. Refunds recorded while off are sent by the
# hourly refund job once this is turned on.
REFUNDS_ENABLED=
#
# DISPUTE_DECISIONS_ENABLED: must be exactly "true" before an admin's decision
# on a dispute takes effect. While it is off, deciding only reports what it
# would do and writes nothing. Reporting a problem and holding the host's
# payout are always on. A refund a decision creates is still behind
# REFUNDS_ENABLED, and a payout behind PAYOUTS_ENABLED.
DISPUTE_DECISIONS_ENABLED=
#
# PAYMENT_WEBHOOK_ENABLED: must be exactly "true" before Paystack's
# charge.success webhook confirms a payment. While it is off the event is
# still signature-checked and logged as what it would do, and nothing is
# written. Payments are still confirmed when the guest's browser returns.
PAYMENT_WEBHOOK_ENABLED=
#
# BOOKING_EXPIRY_ENABLED: must be exactly "true" before the expiry job ends
# unpaid bookings and unanswered requests. Otherwise it only reports which
# ones it would end, and never calls Paystack.
BOOKING_EXPIRY_ENABLED=
#
# BOOKING_EXPIRY_NOT_BEFORE: a date as YYYY-MM-DD (UTC). Only bookings created
# on or after this day can ever be ended by the expiry job. Required: with
# BOOKING_EXPIRY_ENABLED=true but no valid date here, the job stays in dry run.
BOOKING_EXPIRY_NOT_BEFORE=
#
# Every cron job also accepts ?dryRun=1 to force a report-only run.

# ── Messaging (email and SMS) ────────────────────────────────────────────
# Everything here is OFF when unset. Leave it all unset until a provider
# account exists. While off, every message is still worked out and recorded
# in the message log (admin page, Messages tab) with status LOGGED, and
# nothing is sent anywhere. A message logged while off is never sent later.
#
# MESSAGING_ENABLED: must be exactly "true" before anything can be sent.
MESSAGING_ENABLED=
#
# EMAIL_PROVIDER / SMS_PROVIDER: the adapter each channel sends through.
# Unset (or "log") means that channel only logs, even with MESSAGING_ENABLED
# on, so email can go live before SMS. A name with no adapter sends nothing.
# Email: "resend" is the one real adapter (src/lib/messaging/providers). Real
# email goes out only with MESSAGING_ENABLED=true AND EMAIL_PROVIDER=resend.
# SMS: no real adapter is written yet.
EMAIL_PROVIDER=
SMS_PROVIDER=
#
# RESEND_API_KEY: the Resend API key, used only by the resend adapter. It is
# read from the environment when an email is sent and is never logged or
# stored. If it is missing while email is switched on, nothing is called and
# each email is retried (5 minutes, 30 minutes, 2 hours), then given up with
# an alert. The fiegh.com domain must be verified in Resend first.
RESEND_API_KEY=
#
# EMAIL_FROM: the whole From line. Default: "FieGH <support@fiegh.com>".
# The address must be on a domain verified in Resend.
# SUPPORT_EMAIL: the reply-to, also shown in messages. Default:
# support@fiegh.com. SMS_SENDER_ID: default FieGH.
EMAIL_FROM=
SUPPORT_EMAIL=
SMS_SENDER_ID=
#
# To send one test email by hand before switching anything on:
#   npm run email:test -- you@example.com --confirm
#
# ADMIN_ALERT_EMAIL: one shared inbox for everything admins are emailed
# about. Unset: those emails are skipped (the in-app notices still appear).
ADMIN_ALERT_EMAIL=
