{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    { "path": "/api/cron/process-payouts", "schedule": "0 * * * *" },
    { "path": "/api/cron/complete-bookings", "schedule": "0 * * * *" },
    { "path": "/api/cron/process-refunds", "schedule": "30 * * * *" },
    { "path": "/api/cron/send-messages", "schedule": "* * * * *" },
    { "path": "/api/cron/expire-bookings", "schedule": "*/15 * * * *" },
    { "path": "/api/cron/check-disputes", "schedule": "0 9 * * *" },
    { "path": "/api/cron/update-exchange-rate", "schedule": "0 */6 * * *" }
  ]
}
