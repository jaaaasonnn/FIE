generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String   @id @default(cuid())
  name          String?
  email         String?  @unique
  phone         String?  @unique
  passwordHash  String?
  role          String   @default("GUEST") // GUEST | HOST | ADMIN
  profilePhoto  String?
  bio           String?
  nationality   String?
  businessName  String?
  trustScore    Int      @default(0)
  isVerified    Boolean  @default(false)
  isSuperhost   Boolean  @default(false)
  // Off turns off the optional emails only (new-message alerts, review
  // prompts, reviews received, welcome). Everything else is always sent.
  optionalEmails Boolean @default(true)
  // When the person proved the email address is theirs, by a link sent to it
  // (lib/authTokens.ts). Null until then. Not the ID badge: that is isVerified.
  emailVerifiedAt DateTime?

  // Host payout destination — resolved + registered with Paystack before
  // being trusted. payoutMethodVerifiedAt is null until a successful
  // resolve+recipient-create; the payout flow should refuse to pay out
  // against an unverified method.
  payoutMethod             String?   // MOMO | BANK_TRANSFER
  payoutMomoNetwork        String?   // MTN | VODAFONE | AIRTELTIGO
  payoutMomoNumber         String?
  payoutBankCode           String?
  payoutBankAccountNumber  String?
  payoutBankAccountName    String?
  paystackRecipientCode    String?
  payoutMethodVerifiedAt   DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  listings        Listing[]
  guestBookings   Booking[]      @relation("GuestBookings")
  hostBookings    Booking[]      @relation("HostBookings")
  sentMessages    Message[]      @relation("SentMessages")
  receivedMessages Message[]     @relation("ReceivedMessages")
  reviewsGiven    Review[]       @relation("ReviewsGiven")
  reviewsReceived Review[]       @relation("ReviewsReceived")
  verification    Verification?
  disputes        Dispute[]
  disputeEvidence DisputeEvidence[]
  disputeEvents   DisputeEvent[]
  payouts         Payout[]
  instalmentsCovered Instalment[]
  wishlists       Wishlist[]
  sessions        Session[]
  notifications   Notification[]
  messageLogs     MessageLog[]
  authTokens      AuthToken[]
  checksMade      ListingCheck[] @relation("ChecksMade")
  checksRevoked   ListingCheck[] @relation("ChecksRevoked")
}

// A single-use link sent by email: to confirm an address, to confirm a change
// of address, or to reset a password. Only the SHA-256 hash of the token is
// stored, so nothing here can be used to follow a link. Rules in lib/authTokens.ts.
model AuthToken {
  id        String    @id @default(cuid())
  userId    String
  purpose   String    // VERIFY_EMAIL | CHANGE_EMAIL | RESET_PASSWORD
  tokenHash String    @unique
  email     String    // the address the link was sent to: for CHANGE_EMAIL, the new one
  expiresAt DateTime
  usedAt    DateTime? // set when it is followed, or when a newer one replaces it
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

// One row per request for such a link, whether or not the address has an
// account, so requests can be limited per person and per IP address. The IP
// is stored hashed.
model AuthRequest {
  id        String   @id @default(cuid())
  kind      String   // VERIFY_EMAIL | CHANGE_EMAIL | RESET_PASSWORD
  ipHash    String?
  userId    String?  // no relation on purpose: the request is kept whatever becomes of the user
  createdAt DateTime @default(now())

  @@index([ipHash, createdAt])
  @@index([userId, createdAt])
}

// Minimal in-app notification — email isn't wired up yet, so this is the
// real (not stubbed) delivery mechanism for security-sensitive alerts like
// a payout method change. Deliberately simple: one flat table, no per-type
// schema, surfaced as a dismissible banner rather than a full notification
// center.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String    // e.g. PAYOUT_METHOD_CHANGED
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// One row per message to one person on one channel: what was (or would have
// been) sent, to whom, and what became of it. Written by lib/messaging/notify.ts
// and sent by the send-messages job (lib/messaging/deliver.ts). dedupeKey is
// unique, so the same event can never produce the same message twice.
// The real address is never stored here: recipientMasked is for reading only,
// and the address is looked up from User when the message is sent.
model MessageLog {
  id                String    @id @default(cuid())
  event             String
  channel           String    // EMAIL | SMS | IN_APP
  userId            String?
  recipientRole     String    // GUEST | HOST | ADMIN
  recipientMasked   String?
  bookingId         String?   // no relation on purpose: a booking can be deleted without touching the log
  dedupeKey         String    @unique
  subject           String?
  body              String
  status            String    @default("QUEUED") // QUEUED | SENDING | LOGGED | SENT | FAILED | GAVE_UP | SKIPPED | UNKNOWN
  provider          String?
  providerMessageId String?
  error             String?
  // For the few messages that carry a secret link or go to an address other
  // than the one on the account: the token and the address, encrypted
  // (lib/sealed.ts). The body shows "[token]" in its place. Cleared once the
  // message is sent or closed, and never written while the channel is off.
  sealed            String?
  attempts          Int       @default(0)
  claimedAt         DateTime?
  nextAttemptAt     DateTime?
  sentAt            DateTime?
  alertedAt         DateTime?
  createdAt         DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, nextAttemptAt])
  @@index([createdAt])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Listing {
  id                    String   @id @default(cuid())
  hostId                String
  title                 String
  description           String
  propertyType          String   // Apartment | House | Villa | Studio | Townhouse | Guestroom | Entire compound | Serviced apartment
  region                String
  city                  String
  neighbourhood         String?
  // Ghana Post digital address, stored as "GA-183-8164" (lib/digitalAddress.ts).
  // Never public: it pins the home to a few metres. A guest sees it once
  // their booking is confirmed and paid.
  digitalAddress        String?
  lat                   Float?
  lng                   Float?
  bedrooms              Int
  bathrooms             Int
  maxGuests             Int
  amenities             String   // JSON array stored as string
  rentalModes           String   // JSON array: ["SHORT_STAY","TEMP_STAY","PERMANENT"]
  priceNightly          Float?
  priceMonthly          Float?
  priceAnnual           Float?
  advanceMonthsRequired Int?
  photos                String   // JSON array of URLs
  rules                 String?  // JSON array
  cancellationPolicy    String   @default("MODERATE") // FLEXIBLE | MODERATE | STRICT
  instantBook           Boolean  @default(false)
  minStayNights         Int      @default(1)
  isActive              Boolean  @default(true)
  // Set when an admin switches the listing off or the contact-details check
  // fails. While true the host cannot make the listing active; only an admin
  // clears it.
  moderationHold        Boolean  @default(false)
  isFeatured            Boolean  @default(false)
  avgRating             Float    @default(0)
  reviewCount           Int      @default(0)
  welcomeMessage        String?
  damageDeposit         Float?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  host      User      @relation(fields: [hostId], references: [id], onDelete: Cascade)
  bookings  Booking[]
  reviews   Review[]
  wishlists Wishlist[]
  blockedDates BlockedDate[]
  messages  Message[]
  checks    ListingCheck[]
}

// One row each time an admin checks a listing's address and photos
// (lib/listingChecks.ts). The listing shows "Address and photos checked"
// while its latest row is not revoked and has not expired: that is worked out
// when it is read, never by a job. A row is never changed except to set the
// revoke fields, once, so the table is also the record of who did what.
// It says nothing about who owns the home.
model ListingCheck {
  id             String    @id @default(cuid())
  listingId      String
  checkedById    String
  checkedAt      DateTime  @default(now())
  expiresAt      DateTime
  method         String    // VIDEO_CALL | VISIT
  checks         String    // JSON array of the checklist items confirmed
  note           String    // private: admins only
  digitalAddress String    // as it was when checked
  photos         String    // JSON array of the photo URLs as they were when checked
  revokedAt      DateTime?
  revokedById    String?   // null when an edit removed it
  revokeReason   String?   // ADMIN | ADDRESS_CHANGED | DETAILS_CHANGED | PHOTOS_CHANGED | LISTING_HELD | REPLACED
  revokeNote     String?

  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  checkedBy User    @relation("ChecksMade", fields: [checkedById], references: [id])
  revokedBy User?   @relation("ChecksRevoked", fields: [revokedById], references: [id])

  @@index([listingId, revokedAt, expiresAt])
  @@index([expiresAt])
}

model BlockedDate {
  id        String   @id @default(cuid())
  listingId String
  date      DateTime
  reason    String?  // BOOKED (a guest's instant booking) | HOST (blocked by the host, stored at 12:00 UTC of the day)
  note      String?  // Host's private note on a HOST block. Never sent to guests.
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  // Search by dates and the host calendar look up a listing's days in a range
  @@index([listingId, date])
}

model Booking {
  id              String   @id @default(cuid())
  listingId       String
  guestId         String
  hostId          String
  rentalMode      String   // SHORT_STAY | TEMP_STAY | PERMANENT
  checkIn         DateTime
  checkOut        DateTime
  nightsOrMonths  Int
  pricePerUnit    Float
  subtotal        Float
  serviceFee      Float
  damageDeposit   Float    @default(0)
  totalPrice      Float
  status          String   @default("PENDING") // PENDING | CONFIRMED | DECLINED | CANCELLED | COMPLETED | DISPUTED
  paymentStatus    String   @default("UNPAID") // UNPAID | PAID | PARTIALLY_REFUNDED | REFUNDED
  paymentReference String?  // Paystack reference stored on booking for fast webhook lookup
  specialRequests  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Cancellation. cancellationPolicy is the listing's policy copied at the
  // time of booking, so a host changing the listing later does not change
  // this guest's terms (null on bookings made before policies were enforced).
  cancellationPolicy String?   // FLEXIBLE | MODERATE | STRICT
  cancelledBy        String?   // GUEST | HOST | SYSTEM (not paid or not answered in time)
  cancelledAt        DateTime?
  cancelReason       String?   // host cancellations: a reason code, then an optional note. SYSTEM: UNPAID_EXPIRED | NO_HOST_RESPONSE

  // The moment an unpaid booking must be paid by: set when an instant booking
  // is made and when a host accepts a request (lib/payDeadline.ts). Null on
  // requests not yet accepted and on bookings from before deadlines existed,
  // which the expiry job never touches.
  payBy              DateTime?

  // A tenancy a host or an admin ended before its agreed last day. checkOut
  // becomes the end of the last month paid or covered, and the agreed date is
  // kept here. Null on every booking that ran, or will run, its full length.
  originalCheckOut   DateTime?
  endedEarlyBy       String?   // HOST | ADMIN
  endedEarlyAt       DateTime?

  listing   Listing   @relation(fields: [listingId], references: [id])
  guest     User      @relation("GuestBookings", fields: [guestId], references: [id])
  host      User      @relation("HostBookings", fields: [hostId], references: [id])
  payments  Payment[]
  reviews   Review[]
  messages  Message[]
  disputes  Dispute[]
  application RentalApplication?
  payouts   Payout[]
  refund    Refund?
  instalments Instalment[]

  // Search by dates looks for a listing's stays that overlap a range
  @@index([listingId, checkIn, checkOut])
}

// One rent payment of a monthly or long-term booking. Written when the booking
// is made (lib/rentRules.ts) and never for short stays. The first covers the
// months paid in advance and carries the damage deposit; each later one covers
// one month and falls due on the day that month starts. A booking with no rows
// here is paid in one payment, as before instalments existed.
model Instalment {
  id                 String    @id @default(cuid())
  bookingId          String
  sequence           Int       // 1, 2, 3 ...
  periodStart        DateTime  // first day covered, at 12:00 UTC like every stay date
  periodEnd          DateTime  // the day after the last day covered
  dueDate            DateTime
  amount             Float     // rent only, in USD
  depositAmount      Float     @default(0) // the damage deposit, on the first instalment only
  status             String    @default("PENDING") // PENDING | PAID | PART_COVERED | COVERED | CANCELLED
  paidAt             DateTime? // when it was settled in full, by a payment or from the deposit
  // Rent an admin took from the damage deposit for a missed payment, by whom and when
  coveredFromDeposit Float     @default(0)
  coveredById        String?
  coveredAt          DateTime?
  createdAt          DateTime  @default(now())

  booking   Booking   @relation(fields: [bookingId], references: [id])
  coveredBy User?     @relation(fields: [coveredById], references: [id])
  payments  Payment[]
  payouts   Payout[]

  @@unique([bookingId, sequence])
  @@index([status, dueDate])
}

model RentalApplication {
  id               String   @id @default(cuid())
  bookingId        String   @unique
  employmentStatus String
  monthlyIncome    String
  reason           String
  references       String?
  status           String   @default("PENDING") // PENDING | ACCEPTED | DECLINED
  createdAt        DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Payment {
  id               String   @id @default(cuid())
  bookingId        String
  amount           Float
  currency         String   @default("USD")
  method           String   // MOMO | CARD
  momoNetwork      String?  // MTN | VODAFONE | AIRTELTIGO
  momoNumber       String?
  status           String   @default("PENDING") // PENDING | SUCCESS | FAILED | REFUNDED | MISMATCH | DUPLICATE
  gatewayReference String?  @unique
  createdAt        DateTime @default(now())

  // What Paystack was actually asked to charge, in pesewas, and the rate used.
  // Saved at charge time so a refund returns the exact cedis the guest paid.
  amountPesewas    Int?
  usdToGhs         Float?

  // The rent instalment this payment is for. Null on a payment for a whole booking.
  instalmentId     String?

  booking    Booking     @relation(fields: [bookingId], references: [id])
  instalment Instalment? @relation(fields: [instalmentId], references: [id])
  refunds    Refund[]

  @@index([instalmentId])
}

// Money owed back to a guest for one booking. Written when the booking is
// cancelled, whether or not refunds are switched on; sent to Paystack by
// lib/refunds.ts. bookingId is unique: one refund per booking.
model Refund {
  id               String   @id @default(cuid())
  bookingId        String   @unique
  paymentId        String
  reason           String   // GUEST_CANCELLED | HOST_CANCELLED | LATE_PAYMENT | DISPUTE_FULL | DISPUTE_PARTIAL | DISPUTE_DEPOSIT
  policy           String?  // the policy applied, for guest cancellations
  stayRefund       Float
  serviceFeeRefund Float
  depositRefund    Float
  amount           Float    // the three parts added together, in USD
  currency         String   @default("USD")
  amountPesewas    Int?     // the same share of the cedis charged; null if the payment has no stored cedi amount
  status           String   @default("PENDING") // PENDING | PROCESSING | PROCESSED | FAILED | NEEDS_ATTENTION
  paystackRefundId String?
  failureReason    String?
  retryCount       Int      @default(0)
  lastFailedAt     DateTime?
  alertedAt        DateTime?
  initiatedAt      DateTime?
  processedAt      DateTime?
  createdAt        DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id])
  payment Payment @relation(fields: [paymentId], references: [id])
}

model Payout {
  id            String   @id @default(cuid())
  hostId        String
  amount        Float
  currency      String   @default("USD")
  method        String   // MOMO | BANK_TRANSFER
  momoNetwork   String?
  momoNumber    String?
  bankName      String?
  accountNumber String?
  accountName   String?
  status        String   @default("PENDING") // PENDING | PROCESSING | COMPLETED | FAILED | HELD (over the transfer limit: paid by hand)
  reference     String?
  createdAt     DateTime @default(now())

  // Transfer tracking — bookingId ties a payout to the specific booking it
  // pays out for (nullable since a future batched-payout model might cover
  // several bookings in one Payout row). paystackTransferReference is our
  // own idempotent key generated before calling Paystack; paystackTransferCode
  // is Paystack's own transfer_code, only present once the call succeeds.
  // Unique with instalmentSeq: the database refuses a second payout for the
  // same booking (seq 0, a stay paid in one go) or the same instalment of it,
  // so two overlapping cron runs can never pay the same thing twice.
  // instalmentSeq is 0, never null, on a whole-booking payout: nulls would
  // not count as equal and the guard would be lost.
  bookingId                 String?
  instalmentId              String?
  instalmentSeq             Int      @default(0)
  paystackTransferCode      String?
  paystackTransferReference String?  @unique
  failureReason             String?
  initiatedAt                DateTime?
  completedAt                DateTime?

  // Retry policy (see src/lib/payouts.ts). retryCount is how many automatic
  // retries have been attempted — capped at MAX_PAYOUT_RETRIES so a failing
  // payout can never loop forever. lastFailedAt drives the delay before the
  // cron picks it back up. alertedAt is set once the failure has been sent
  // to Sentry and the payout is out of the retry pool for good.
  retryCount                Int       @default(0)
  lastFailedAt              DateTime?
  alertedAt                 DateTime?

  host       User        @relation(fields: [hostId], references: [id])
  booking    Booking?    @relation(fields: [bookingId], references: [id])
  instalment Instalment? @relation(fields: [instalmentId], references: [id])

  @@unique([bookingId, instalmentSeq])
}

model Review {
  id          String   @id @default(cuid())
  bookingId   String
  listingId   String?
  reviewerId  String
  revieweeId  String
  rating      Int
  comment     String
  type        String   // GUEST_TO_HOST | HOST_TO_GUEST
  isPublished Boolean  @default(false)
  hostReply   String?
  createdAt   DateTime @default(now())

  booking  Booking @relation(fields: [bookingId], references: [id])
  reviewer User    @relation("ReviewsGiven", fields: [reviewerId], references: [id])
  reviewee User    @relation("ReviewsReceived", fields: [revieweeId], references: [id])
  listing  Listing? @relation(fields: [listingId], references: [id])
}

model Message {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  bookingId  String?
  listingId  String?
  content    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender   User     @relation("SentMessages", fields: [senderId], references: [id])
  receiver User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  booking  Booking? @relation(fields: [bookingId], references: [id])
  listing  Listing? @relation(fields: [listingId], references: [id])
}

// A problem reported on a booking. One per side per booking: the guest can
// raise one (the home is not as promised) and the host can raise one (damage,
// about the deposit). Rules in src/lib/disputes.ts.
model Dispute {
  id           String    @id @default(cuid())
  bookingId    String
  raisedById   String
  raisedByRole String    @default("GUEST") // GUEST | HOST
  reason       String    // a code from GUEST_REASONS or HOST_REASONS
  description  String?
  response     String?   // the other party's one reply
  respondedAt  DateTime?
  status       String    @default("OPEN") // OPEN | UNDER_REVIEW | RESOLVED | CLOSED
  outcome      String?   // FULL_REFUND | PARTIAL_REFUND | DEPOSIT_RETURNED | DEPOSIT_KEPT | REJECTED
  refundAmount Float?    // the amount the admin entered, for PARTIAL_REFUND and DEPOSIT_KEPT
  resolution   String?   // why, shown to both parties
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  booking   Booking           @relation(fields: [bookingId], references: [id])
  raisedBy  User              @relation(fields: [raisedById], references: [id])
  evidence  DisputeEvidence[]
  events    DisputeEvent[]

  @@unique([bookingId, raisedByRole])
}

// A photo attached to a dispute by one of the two parties. The file lives in
// the private dispute-evidence bucket; `path` is its key there.
model DisputeEvidence {
  id           String   @id @default(cuid())
  disputeId    String
  uploadedById String
  path         String
  contentType  String
  sizeBytes    Int
  createdAt    DateTime @default(now())

  dispute    Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  uploadedBy User    @relation(fields: [uploadedById], references: [id])
}

// The history of a dispute: who did what, and any note. ADMIN_NOTE is seen
// by admins only; every other type is shown to both parties.
model DisputeEvent {
  id        String   @id @default(cuid())
  disputeId String
  actorId   String
  type      String   // RAISED | REPLIED | UNDER_REVIEW | RESOLVED | CORRECTION | ADMIN_NOTE
  note      String?
  createdAt DateTime @default(now())

  dispute Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  actor   User    @relation(fields: [actorId], references: [id])
}

model Verification {
  id           String   @id @default(cuid())
  userId       String   @unique
  idType       String   // GHANA_CARD | PASSPORT | VOTER_ID
  idPhotoUrl   String
  selfieUrl    String?
  status       String   @default("PENDING") // PENDING | APPROVED | REJECTED
  reviewedById String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
}

model ExchangeRate {
  id        String   @id @default(cuid())
  usdToGhs  Float
  updatedAt DateTime @updatedAt
  updatedBy String?
}

model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}
