generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String   @id @default(cuid())
  name          String?
  email         String?  @unique
  phone         String?  @unique
  passwordHash  String?
  role          String   @default("GUEST") // GUEST | HOST | ADMIN
  profilePhoto  String?
  bio           String?
  nationality   String?
  businessName  String?
  trustScore    Int      @default(0)
  isVerified    Boolean  @default(false)
  isSuperhost   Boolean  @default(false)

  // Host payout destination — resolved + registered with Paystack before
  // being trusted. payoutMethodVerifiedAt is null until a successful
  // resolve+recipient-create; the payout flow should refuse to pay out
  // against an unverified method.
  payoutMethod             String?   // MOMO | BANK_TRANSFER
  payoutMomoNetwork        String?   // MTN | VODAFONE | AIRTELTIGO
  payoutMomoNumber         String?
  payoutBankCode           String?
  payoutBankAccountNumber  String?
  payoutBankAccountName    String?
  paystackRecipientCode    String?
  payoutMethodVerifiedAt   DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  listings        Listing[]
  guestBookings   Booking[]      @relation("GuestBookings")
  hostBookings    Booking[]      @relation("HostBookings")
  sentMessages    Message[]      @relation("SentMessages")
  receivedMessages Message[]     @relation("ReceivedMessages")
  reviewsGiven    Review[]       @relation("ReviewsGiven")
  reviewsReceived Review[]       @relation("ReviewsReceived")
  verification    Verification?
  disputes        Dispute[]
  disputeEvidence DisputeEvidence[]
  disputeEvents   DisputeEvent[]
  payouts         Payout[]
  wishlists       Wishlist[]
  sessions        Session[]
  notifications   Notification[]
}

// Minimal in-app notification — email isn't wired up yet, so this is the
// real (not stubbed) delivery mechanism for security-sensitive alerts like
// a payout method change. Deliberately simple: one flat table, no per-type
// schema, surfaced as a dismissible banner rather than a full notification
// center.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String    // e.g. PAYOUT_METHOD_CHANGED
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Listing {
  id                    String   @id @default(cuid())
  hostId                String
  title                 String
  description           String
  propertyType          String   // Apartment | House | Villa | Studio | Townhouse | Guestroom | Entire compound | Serviced apartment
  region                String
  city                  String
  neighbourhood         String?
  lat                   Float?
  lng                   Float?
  bedrooms              Int
  bathrooms             Int
  maxGuests             Int
  amenities             String   // JSON array stored as string
  rentalModes           String   // JSON array: ["SHORT_STAY","TEMP_STAY","PERMANENT"]
  priceNightly          Float?
  priceMonthly          Float?
  priceAnnual           Float?
  advanceMonthsRequired Int?
  photos                String   // JSON array of URLs
  rules                 String?  // JSON array
  cancellationPolicy    String   @default("FLEXIBLE") // FLEXIBLE | MODERATE | STRICT
  instantBook           Boolean  @default(false)
  minStayNights         Int      @default(1)
  isActive              Boolean  @default(true)
  // Set when an admin switches the listing off or the contact-details check
  // fails. While true the host cannot make the listing active; only an admin
  // clears it.
  moderationHold        Boolean  @default(false)
  isFeatured            Boolean  @default(false)
  avgRating             Float    @default(0)
  reviewCount           Int      @default(0)
  welcomeMessage        String?
  damageDeposit         Float?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  host      User      @relation(fields: [hostId], references: [id], onDelete: Cascade)
  bookings  Booking[]
  reviews   Review[]
  wishlists Wishlist[]
  blockedDates BlockedDate[]
  messages  Message[]
}

model BlockedDate {
  id        String   @id @default(cuid())
  listingId String
  date      DateTime
  reason    String?  // BOOKED (a guest's instant booking) | HOST (blocked by the host, stored at 12:00 UTC of the day)
  note      String?  // Host's private note on a HOST block. Never sent to guests.
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  // Search by dates and the host calendar look up a listing's days in a range
  @@index([listingId, date])
}

model Booking {
  id              String   @id @default(cuid())
  listingId       String
  guestId         String
  hostId          String
  rentalMode      String   // SHORT_STAY | TEMP_STAY | PERMANENT
  checkIn         DateTime
  checkOut        DateTime
  nightsOrMonths  Int
  pricePerUnit    Float
  subtotal        Float
  serviceFee      Float
  damageDeposit   Float    @default(0)
  totalPrice      Float
  status          String   @default("PENDING") // PENDING | CONFIRMED | DECLINED | CANCELLED | COMPLETED | DISPUTED
  paymentStatus    String   @default("UNPAID") // UNPAID | PAID | PARTIALLY_REFUNDED | REFUNDED
  paymentReference String?  // Paystack reference stored on booking for fast webhook lookup
  specialRequests  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Cancellation. cancellationPolicy is the listing's policy copied at the
  // time of booking, so a host changing the listing later does not change
  // this guest's terms (null on bookings made before policies were enforced).
  cancellationPolicy String?   // FLEXIBLE | MODERATE | STRICT
  cancelledBy        String?   // GUEST | HOST
  cancelledAt        DateTime?
  cancelReason       String?   // host cancellations: a reason code, then an optional note

  listing   Listing   @relation(fields: [listingId], references: [id])
  guest     User      @relation("GuestBookings", fields: [guestId], references: [id])
  host      User      @relation("HostBookings", fields: [hostId], references: [id])
  payments  Payment[]
  reviews   Review[]
  messages  Message[]
  disputes  Dispute[]
  application RentalApplication?
  payouts   Payout[]
  refund    Refund?

  // Search by dates looks for a listing's stays that overlap a range
  @@index([listingId, checkIn, checkOut])
}

model RentalApplication {
  id               String   @id @default(cuid())
  bookingId        String   @unique
  employmentStatus String
  monthlyIncome    String
  reason           String
  references       String?
  status           String   @default("PENDING") // PENDING | ACCEPTED | DECLINED
  createdAt        DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Payment {
  id               String   @id @default(cuid())
  bookingId        String
  amount           Float
  currency         String   @default("USD")
  method           String   // MOMO | CARD
  momoNetwork      String?  // MTN | VODAFONE | AIRTELTIGO
  momoNumber       String?
  status           String   @default("PENDING") // PENDING | SUCCESS | FAILED | REFUNDED
  gatewayReference String?
  createdAt        DateTime @default(now())

  // What Paystack was actually asked to charge, in pesewas, and the rate used.
  // Saved at charge time so a refund returns the exact cedis the guest paid.
  amountPesewas    Int?
  usdToGhs         Float?

  booking Booking  @relation(fields: [bookingId], references: [id])
  refunds Refund[]
}

// Money owed back to a guest for one booking. Written when the booking is
// cancelled, whether or not refunds are switched on; sent to Paystack by
// lib/refunds.ts. bookingId is unique: one refund per booking.
model Refund {
  id               String   @id @default(cuid())
  bookingId        String   @unique
  paymentId        String
  reason           String   // GUEST_CANCELLED | HOST_CANCELLED | LATE_PAYMENT | DISPUTE_FULL | DISPUTE_PARTIAL | DISPUTE_DEPOSIT
  policy           String?  // the policy applied, for guest cancellations
  stayRefund       Float
  serviceFeeRefund Float
  depositRefund    Float
  amount           Float    // the three parts added together, in USD
  currency         String   @default("USD")
  amountPesewas    Int?     // the same share of the cedis charged; null if the payment has no stored cedi amount
  status           String   @default("PENDING") // PENDING | PROCESSING | PROCESSED | FAILED | NEEDS_ATTENTION
  paystackRefundId String?
  failureReason    String?
  retryCount       Int      @default(0)
  lastFailedAt     DateTime?
  alertedAt        DateTime?
  initiatedAt      DateTime?
  processedAt      DateTime?
  createdAt        DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id])
  payment Payment @relation(fields: [paymentId], references: [id])
}

model Payout {
  id            String   @id @default(cuid())
  hostId        String
  amount        Float
  currency      String   @default("USD")
  method        String   // MOMO | BANK_TRANSFER
  momoNetwork   String?
  momoNumber    String?
  bankName      String?
  accountNumber String?
  accountName   String?
  status        String   @default("PENDING") // PENDING | PROCESSING | COMPLETED | FAILED
  reference     String?
  createdAt     DateTime @default(now())

  // Transfer tracking — bookingId ties a payout to the specific booking it
  // pays out for (nullable since a future batched-payout model might cover
  // several bookings in one Payout row). paystackTransferReference is our
  // own idempotent key generated before calling Paystack; paystackTransferCode
  // is Paystack's own transfer_code, only present once the call succeeds.
  // Unique: the database refuses a second payout for the same booking, so
  // two overlapping cron runs can never pay one stay twice.
  bookingId                 String?  @unique
  paystackTransferCode      String?
  paystackTransferReference String?  @unique
  failureReason             String?
  initiatedAt                DateTime?
  completedAt                DateTime?

  // Retry policy (see src/lib/payouts.ts). retryCount is how many automatic
  // retries have been attempted — capped at MAX_PAYOUT_RETRIES so a failing
  // payout can never loop forever. lastFailedAt drives the delay before the
  // cron picks it back up. alertedAt is set once the failure has been sent
  // to Sentry and the payout is out of the retry pool for good.
  retryCount                Int       @default(0)
  lastFailedAt              DateTime?
  alertedAt                 DateTime?

  host    User     @relation(fields: [hostId], references: [id])
  booking Booking? @relation(fields: [bookingId], references: [id])
}

model Review {
  id          String   @id @default(cuid())
  bookingId   String
  listingId   String?
  reviewerId  String
  revieweeId  String
  rating      Int
  comment     String
  type        String   // GUEST_TO_HOST | HOST_TO_GUEST
  isPublished Boolean  @default(false)
  hostReply   String?
  createdAt   DateTime @default(now())

  booking  Booking @relation(fields: [bookingId], references: [id])
  reviewer User    @relation("ReviewsGiven", fields: [reviewerId], references: [id])
  reviewee User    @relation("ReviewsReceived", fields: [revieweeId], references: [id])
  listing  Listing? @relation(fields: [listingId], references: [id])
}

model Message {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  bookingId  String?
  listingId  String?
  content    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender   User     @relation("SentMessages", fields: [senderId], references: [id])
  receiver User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  booking  Booking? @relation(fields: [bookingId], references: [id])
  listing  Listing? @relation(fields: [listingId], references: [id])
}

// A problem reported on a booking. One per side per booking: the guest can
// raise one (the home is not as promised) and the host can raise one (damage,
// about the deposit). Rules in src/lib/disputes.ts.
model Dispute {
  id           String    @id @default(cuid())
  bookingId    String
  raisedById   String
  raisedByRole String    @default("GUEST") // GUEST | HOST
  reason       String    // a code from GUEST_REASONS or HOST_REASONS
  description  String?
  response     String?   // the other party's one reply
  respondedAt  DateTime?
  status       String    @default("OPEN") // OPEN | UNDER_REVIEW | RESOLVED | CLOSED
  outcome      String?   // FULL_REFUND | PARTIAL_REFUND | DEPOSIT_RETURNED | DEPOSIT_KEPT | REJECTED
  refundAmount Float?    // the amount the admin entered, for PARTIAL_REFUND and DEPOSIT_KEPT
  resolution   String?   // why, shown to both parties
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  booking   Booking           @relation(fields: [bookingId], references: [id])
  raisedBy  User              @relation(fields: [raisedById], references: [id])
  evidence  DisputeEvidence[]
  events    DisputeEvent[]

  @@unique([bookingId, raisedByRole])
}

// A photo attached to a dispute by one of the two parties. The file lives in
// the private dispute-evidence bucket; `path` is its key there.
model DisputeEvidence {
  id           String   @id @default(cuid())
  disputeId    String
  uploadedById String
  path         String
  contentType  String
  sizeBytes    Int
  createdAt    DateTime @default(now())

  dispute    Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  uploadedBy User    @relation(fields: [uploadedById], references: [id])
}

// The history of a dispute: who did what, and any note. ADMIN_NOTE is seen
// by admins only; every other type is shown to both parties.
model DisputeEvent {
  id        String   @id @default(cuid())
  disputeId String
  actorId   String
  type      String   // RAISED | REPLIED | UNDER_REVIEW | RESOLVED | CORRECTION | ADMIN_NOTE
  note      String?
  createdAt DateTime @default(now())

  dispute Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  actor   User    @relation(fields: [actorId], references: [id])
}

model Verification {
  id           String   @id @default(cuid())
  userId       String   @unique
  idType       String   // GHANA_CARD | PASSPORT | VOTER_ID
  idPhotoUrl   String
  selfieUrl    String?
  status       String   @default("PENDING") // PENDING | APPROVED | REJECTED
  reviewedById String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
}

model ExchangeRate {
  id        String   @id @default(cuid())
  usdToGhs  Float
  updatedAt DateTime @updatedAt
  updatedBy String?
}

model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}
