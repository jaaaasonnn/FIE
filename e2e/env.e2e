# The whole environment of the end-to-end tests. Every value here is fake and
# points at this machine only. Nothing is read from .env: the launcher
# (run.mjs) gives every key that .env has a value from this file, or a
# placeholder, so Next and Prisma never fall back to a real one.
#
# The switches are on HERE ONLY, against the local fakes. They are never set
# in .env or on Vercel by anything in this folder.

DATABASE_URL=postgresql://postgres:e2e@127.0.0.1:54329/fiegh_e2e?pgbouncer=true
DIRECT_URL=postgresql://postgres:e2e@127.0.0.1:54329/fiegh_e2e

NEXTAUTH_SECRET=e2e-secret-not-used-anywhere-real-0123456789
CRON_SECRET=e2e-cron-secret

# Paystack: a made-up key in the right shape. Requests go to the local fake (preload/egress.cjs).
PAYSTACK_SECRET_KEY=sk_test_e2e_0000000000000000000000000000000000
PAYSTACK_PUBLIC_KEY=pk_test_e2e_0000000000000000000000000000000000

# Resend: the local fake's inbox
RESEND_API_KEY=re_e2e_fake
MESSAGING_ENABLED=true
EMAIL_PROVIDER=resend
ADMIN_ALERT_EMAIL=admins@fiegh.test

# Storage: a host name that does not exist, sent to the local fake by the preload
SUPABASE_URL=https://e2e-storage.fiegh.test
SUPABASE_SERVICE_ROLE_KEY=e2e-service-key

# Sentry: the local fake collects what would have been reported. No upload token.
NEXT_PUBLIC_SENTRY_DSN=http://e2ekey@127.0.0.1:4010/1
SENTRY_AUTH_TOKEN=

NEXT_PUBLIC_MAPTILER_KEY=e2e-map-key
EXCHANGE_RATE_API_KEY=e2e-rate-key
INITIAL_USD_TO_GHS=15.5

# Switches (test environment only)
PAYOUTS_ENABLED=true
PAYOUTS_NOT_BEFORE=2020-01-01
COMPLETION_ENABLED=true
REFUNDS_ENABLED=true
DISPUTE_DECISIONS_ENABLED=true
PAYMENT_WEBHOOK_ENABLED=true
BOOKING_EXPIRY_ENABLED=true
BOOKING_EXPIRY_NOT_BEFORE=2020-01-01
RENT_REMINDERS_ENABLED=true
RENT_DEPOSIT_COVER_ENABLED=true

NEXT_TELEMETRY_DISABLED=1

# The most one transfer may be, so the over-the-limit hold can be tested (not a switch)
PAYOUT_LIMIT_GHS=50000
